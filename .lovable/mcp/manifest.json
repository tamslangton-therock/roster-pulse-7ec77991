{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hrggsjyqzhrbrezaipjc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "roster-pulse",
      "version": "0.1.0",
      "title": "Roster Pulse"
    },
    "tools": [
      {
        "name": "list_roster",
        "title": "List roster assignments",
        "description": "List who is rostered on which Sunday, optionally filtered by date range, serving area or person.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date (YYYY-MM-DD), inclusive."
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End date (YYYY-MM-DD), inclusive."
            },
            "area": {
              "type": "string",
              "description": "Serving area filter, e.g. 'Barista' or 'Kids'."
            },
            "person": {
              "type": "string",
              "description": "Person name filter (case-insensitive substring)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Max entries to return (default 200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_sunday",
        "title": "Get one Sunday's roster",
        "description": "Show everyone rostered on a single date, grouped by serving area.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "The date to look up (YYYY-MM-DD)."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_person_schedule",
        "title": "Get a person's serving schedule",
        "description": "Show every past and upcoming roster slot for one volunteer, plus a simple fatigue summary (serves in the last and next 4 weeks, longest run of consecutive weeks).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Volunteer name (case-insensitive substring match)."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_volunteers",
        "title": "List volunteers",
        "description": "List volunteers with their serving areas, monthly limit, frequency preference, partner links and paused state. Contact details are not exposed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Filter by name or serving area (case-insensitive)."
            },
            "paused_only": {
              "type": "boolean",
              "description": "Only return volunteers who are currently paused."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Max volunteers to return (default 200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
